+
+/***********************************************************************
+			    Cursor animation
+ ***********************************************************************/
+
+/* When `cursor-animation-duration' is a number, and the terminal has a
+   `glide_cursor' function, a cursor that moves is not drawn where it
+   moves to until the movement is over.  Instead the terminal shows it
+   moving, as a rectangle that is the cursor, and a quadrilateral that
+   is stretched between where the cursor was and where it is now, both
+   computed here.  When the movement is over `gui_cursor_glide_land'
+   draws the cursor and tells the terminal to stop showing it, so that
+   there is always one cursor, never none or two.  */
+
+static double
+glide_now (void)
+{
+  return timespectod (current_timespec ());
+}
+
+/* Return where the ease-out timing function maps T, between 0 and 1.
+   It stops before it gets really slow, so that the cursor does not
+   crawl to where it is going, and the character shows up when it
+   arrives.  */
+
+static double
+glide_ease_out (double t)
+{
+  return (1 - pow (1 - 0.7 * t, 3)) / (1 - pow (0.3, 3));
+}
+
+/* Store in CORNERS those of the rectangle R, which is x, y, width, and
+   height.  */
+
+static void
+glide_corners (const int *r, double corners[4][2])
+{
+  corners[0][0] = corners[3][0] = r[0];
+  corners[1][0] = corners[2][0] = r[0] + r[2];
+  corners[0][1] = corners[1][1] = r[1];
+  corners[2][1] = corners[3][1] = r[1] + r[3];
+}
+
+/* Compute the shape of the cursor of frame F that is moving, at time T,
+   from 0 to 1, of the movement.  Store the corners of the quadrilateral
+   that is its trail in TRAIL, and those of the rectangle that is the
+   cursor itself in HEAD.  */
+
+void
+gui_cursor_glide_shape (struct frame *f, double t, double trail[4][2],
+			double head[4][2])
+{
+  struct cursor_glide *g = &f->cursor_glide;
+  double e = glide_ease_out (t);
+
+  for (int c = 0; c < 4; c++)
+    {
+      double trailing = pow (e, g->late[c]);
+
+      for (int k = 0; k < 2; k++)
+	{
+	  double delta = g->to[c][k] - g->from[c][k];
+
+	  head[c][k] = g->from[c][k] + delta * e;
+	  trail[c][k] = g->from[c][k] + delta * trailing;
+	}
+    }
+}
+
+/* Return how far the cursor of frame F is in its movement, from 0 to 1.  */
+
+double
+gui_cursor_glide_progress (struct frame *f)
+{
+  struct cursor_glide *g = &f->cursor_glide;
+
+  return min (max ((glide_now () - g->start) / g->duration, 0), 1);
+}
+
+/* Called to draw the cursor of window W, of type TYPE and WIDTH, in
+   the position X, Y of the window, in ROW, on GLYPH, ACTIVE being true
+   if it is the cursor of the selected window.  Return true if it must
+   not be drawn, because the terminal shows it moving.  */
+
+static bool
+gui_glide_cursor (struct window *w, struct glyph_row *row,
+		  struct glyph *glyph, int x, int y,
+		  enum text_cursor_kinds type, int width, bool active)
+{
+  struct frame *f = XFRAME (w->frame);
+
+  if (!FRAME_RIF (f)->glide_cursor)
+    return false;
+
+  struct cursor_glide *g = &f->cursor_glide;
+  double duration = (NUMBERP (Vcursor_animation_duration)
+		     ? XFLOATINT (Vcursor_animation_duration) : 0);
+  if (!g->flight_window && (duration <= 0 || !active))
+    return false;
+
+  double now = glide_now ();
+
+  /* While the terminal shows the cursor, leave it hidden, unless the
+     movement is over or the cursor is going to look different.  */
+  if (g->flight_window == w->sequence_number)
+    {
+      if (active && type != NO_CURSOR && g->flight_x == x && g->flight_y == y
+	  && now < g->start + g->duration)
+	{
+	  w->phys_cursor_on_p = false;
+	  return true;
+	}
+      g->flight_window = 0;
+      FRAME_RIF (f)->glide_cursor (f, false);
+    }
+
+  if (duration <= 0 || !active)
+    return false;
+  if (type == NO_CURSOR || !glyph)
+    {
+      /* Keep the last visible position as the next movement's origin
+         when blinking temporarily hides the cursor.  */
+      if (!glyph || !w->cursor_off_p)
+        g->last_window = 0;
+      return false;
+    }
+
+  /* Compute the rectangle of the cursor, as the terminals do.  */
+  int fx, fy, h, bx, by, bw, bh;
+  get_phys_cursor_geometry (w, row, glyph, &fx, &fy, &h);
+  w->phys_cursor_width = min (w->phys_cursor_width,
+			      type == BAR_CURSOR
+			      ? (width < 1 ? max (FRAME_CURSOR_WIDTH (f), 1)
+				 : width)
+			      : INT_MAX);
+  if (type == BAR_CURSOR && (glyph->resolved_level & 1))
+    fx += glyph->pixel_width - w->phys_cursor_width;
+  if (type == HBAR_CURSOR)
+    {
+      int bar = min (width < 1 ? lrint (0.25 * h) : width, row->height);
+
+      if (h > bar)
+	fy += h - bar;
+      h = bar;
+    }
+  window_box (w, TEXT_AREA, &bx, &by, &bw, &bh);
+
+  int x0 = max (fx, bx), y0 = max (fy, by);
+  int x1 = min (fx + w->phys_cursor_width, bx + bw), y1 = min (fy + h, by + bh);
+  if (x1 <= x0 || y1 <= y0)
+    {
+      g->last_window = 0;
+      return false;
+    }
+
+  /* Find out whether it moved, and from where.  The cursor on an image
+     does not move like this.  */
+  int r[4] = { x0, y0, x1 - x0, y1 - y0 };
+  int previous[4] = { g->last_rect[0], g->last_rect[1],
+		      g->last_rect[2], g->last_rect[3] };
+  bool same_window = g->last_window == w->sequence_number;
+  bool moved = (g->last_window != 0 && glyph->type != IMAGE_GLYPH
+		&& (!same_window || previous[0] != r[0] || previous[1] != r[1]));
+
+  g->last_window = glyph->type == IMAGE_GLYPH ? 0 : w->sequence_number;
+  memcpy (g->last_rect, r, sizeof r);
+  if (!moved)
+    return false;
+
+  /* Start from the shape of the cursor, if it is still moving.  */
+  double old[4][2], new[4][2], lead[4], least = 1, most = -1;
+  bool following = g->flight_window && now < g->start + g->duration;
+
+  glide_corners (r, new);
+  if (following)
+    {
+      double head[4][2];
+
+      gui_cursor_glide_shape (f, gui_cursor_glide_progress (f), old, head);
+    }
+  else
+    glide_corners (previous, old);
+
+  /* The corners of the quadrilateral move with the ease-out timing
+     function, but the more a corner trails behind the movement of the
+     cursor, the later it gets to where the cursor is now, which stretches
+     the quadrilateral.  It does that less if the cursor follows another
+     movement, or if it moves at most two columns and lines, unless to
+     another window, and the stretch is limited for long movements.  */
+  double dx = (new[0][0] + new[2][0] - old[0][0] - old[2][0]) / 2;
+  double dy = (new[0][1] + new[2][1] - old[0][1] - old[2][1]) / 2;
+  double distance = max (hypot (dx, dy), 1);
+  bool near = (same_window
+	       && fabs (round (dx / FRAME_COLUMN_WIDTH (f))) <= 2
+	       && fabs (round (dy / FRAME_LINE_HEIGHT (f))) <= 2);
+  double stretch = min (near ? 0 : following ? 0.6 : 1.5, 8 * r[3] / distance);
+
+  for (int c = 0; c < 4; c++)
+    {
+      /* How much the corner leads the cursor, from 1 to -1.  */
+      double ox = new[c][0] - (new[0][0] + new[2][0]) / 2;
+      double oy = new[c][1] - (new[0][1] + new[2][1]) / 2;
+
+      lead[c] = (ox * dx + oy * dy) / (hypot (ox, oy) * distance);
+      least = min (least, lead[c]);
+      most = max (most, lead[c]);
+    }
+  for (int c = 0; c < 4; c++)
+    g->late[c] = 1 + stretch * (most - lead[c]) / max (most - least, 0.001);
+  memcpy (g->from, old, sizeof old);
+  memcpy (g->to, new, sizeof new);
+  g->flight_window = w->sequence_number;
+  g->flight_x = x;
+  g->flight_y = y;
+  g->start = now;
+  g->duration = duration;
+  FRAME_RIF (f)->glide_cursor (f, true);
+  w->phys_cursor_on_p = false;
+  return true;
+}
+
+/* Called by the terminal when the movement of the cursor of frame F is
+   over.  Draw the cursor, and have the terminal stop showing it.  */
+
+void
+gui_cursor_glide_land (struct frame *f)
+{
+  if (f->cursor_glide.flight_window)
+    {
+      f->cursor_glide.flight_window = 0;
+      gui_update_cursor (f, true);
+      FRAME_RIF (f)->glide_cursor (f, false);
+    }
+}
+
