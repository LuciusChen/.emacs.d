   do { if (f == dpyinfo->FIELD) dpyinfo->FIELD = 0; } while (false)
@@ -3013,6 +3016,91 @@ pgtk_draw_bar_cursor (struct window *w, struct glyph_row *row, int width,
 
 /* RIF: Draw cursor on window W.  */
 
+/* Animation of the cursor, see `gui_glide_cursor' in xdisp.c.  While
+   the cursor moves, `pgtk_handle_draw' paints its head and its trail
+   over the frame, which is redrawn at each tick of the frame clock.  A
+   timeout, not the ticks, which stop when the frame is not shown, tells
+   when the cursor gets there.  */
+
+static void
+pgtk_glide_stop (struct frame *f)
+{
+  struct pgtk_output *output = FRAME_X_OUTPUT (f);
+
+  if (output->glide_tick && FRAME_GTK_WIDGET (f))
+    gtk_widget_remove_tick_callback (FRAME_GTK_WIDGET (f), output->glide_tick);
+  if (output->glide_timeout)
+    g_source_remove (output->glide_timeout);
+  output->glide_tick = output->glide_timeout = 0;
+}
+
+static gboolean
+pgtk_glide_tick (GtkWidget *widget, GdkFrameClock *clock, gpointer data)
+{
+  gtk_widget_queue_draw (widget);
+  return G_SOURCE_CONTINUE;
+}
+
+static gboolean
+pgtk_glide_land (gpointer data)
+{
+  struct frame *f = data;
+
+  FRAME_X_OUTPUT (f)->glide_timeout = 0;
+  gui_cursor_glide_land (f);
+  return G_SOURCE_REMOVE;
+}
+
+/* Show the cursor of F moving if SHOW, or stop.  */
+
+static void
+pgtk_glide_cursor (struct frame *f, bool show)
+{
+  struct pgtk_output *output = FRAME_X_OUTPUT (f);
+
+  pgtk_glide_stop (f);
+  if (show)
+    {
+      output->glide_tick
+	= gtk_widget_add_tick_callback (FRAME_GTK_WIDGET (f), pgtk_glide_tick,
+					NULL, NULL);
+      output->glide_timeout
+	= g_timeout_add (f->cursor_glide.duration * 1000, pgtk_glide_land, f);
+    }
+  gtk_widget_queue_draw (FRAME_GTK_WIDGET (f));
+}
+
+/* Make the path of the quadrilateral with the corners CORNERS in CR.  */
+
+static void
+pgtk_glide_path (cairo_t *cr, double corners[4][2])
+{
+  cairo_move_to (cr, corners[0][0], corners[0][1]);
+  for (int c = 1; c < 4; c++)
+    cairo_line_to (cr, corners[c][0], corners[c][1]);
+  cairo_close_path (cr);
+}
+
+/* Paint the cursor of F, which is moving, in CR: the trail, then the
+   head.  */
+
+static void
+pgtk_paint_glide (struct frame *f, cairo_t *cr)
+{
+  double trail[4][2], head[4][2];
+  Emacs_Color color;
+
+  color.pixel = FRAME_CURSOR_COLOR (f);
+  pgtk_query_color (f, &color);
+  cairo_set_source_rgb (cr, color.red / 65535.0, color.green / 65535.0,
+			color.blue / 65535.0);
+  gui_cursor_glide_shape (f, gui_cursor_glide_progress (f), trail, head);
+  pgtk_glide_path (cr, trail);
+  cairo_fill (cr);
+  pgtk_glide_path (cr, head);
+  cairo_fill (cr);
+}
+
 static void
 pgtk_draw_window_cursor (struct window *w, struct glyph_row *glyph_row, int x,
 			 int y, enum text_cursor_kinds cursor_type,
@@ -3782,6 +3870,7 @@ pgtk_flush_display (struct frame *f)
   pgtk_show_hourglass,
   pgtk_hide_hourglass,
   pgtk_default_font_parameter,
+  pgtk_glide_cursor,
 };
 
 void
@@ -5113,6 +5202,8 @@ pgtk_handle_draw (GtkWidget *widget, cairo_t *cr, gpointer *data)
 	{
 	  cairo_set_source_surface (cr, src, 0, 0);
 	  cairo_paint (cr);
+	  if (f->cursor_glide.flight_window)
+	    pgtk_paint_glide (f, cr);
 	}
     }
   return FALSE;
