+/* ==========================================================================
+
+   Cursor animation
+
+   ========================================================================== */
+
+/* Show the cursor of a frame moving, as `gui_glide_cursor' in xdisp.c
+   computes it, with two CALayers over the frame, the head, which is
+   the cursor, and the trail, which is stretched behind it.  Core
+   Animation moves them, and Emacs does not do anything until the
+   movement is over.  */
+
+@implementation EmacsCursorGlide
+
+- (id) initWithView: (EmacsView *)v frame: (struct frame *)f
+{
+  self = [super init];
+  view = v;
+  frame = f;
+  return self;
+}
+
+
+/* Called when the view goes away.  */
+- (void) detach
+{
+  [NSObject cancelPreviousPerformRequestsWithTarget: self];
+  view = nil;
+}
+
+
+- (void) dealloc
+{
+  [trail removeFromSuperlayer];
+  [trail release];
+  [head removeFromSuperlayer];
+  [head release];
+  [super dealloc];
+}
+
+
+/* Return a path through the corners CORNERS, of the frame, in the
+   coordinates of PARENT.  */
+static CGPathRef
+ns_glide_path (CALayer *parent, double corners[4][2])
+{
+  CGPoint points[4];
+  CGMutablePathRef path = CGPathCreateMutable ();
+
+  for (int c = 0; c < 4; c++)
+    points[c] = CGPointMake (corners[c][0], [parent isGeometryFlipped]
+			     ? corners[c][1]
+			     : NSHeight ([parent bounds]) - corners[c][1]);
+  CGPathAddLines (path, NULL, points, 4);
+  CGPathCloseSubpath (path);
+  return path;
+}
+
+
+/* Show the cursor moving.  */
+- (void) show
+{
+  CALayer *parent = [view layer];
+  enum { STEPS = 20 };
+
+  /* What Emacs draws is shown with the components of its colors in the
+     color space of the layer, taken as they are, so do the same, so that
+     the cursor does not change color when the movement is over.  */
+  NSColorSpace *space
+    = [[[NSColorSpace alloc] initWithCGColorSpace: [(EmacsLayer *) parent
+						     colorSpace]] autorelease];
+  CGFloat rgba[4];
+  [[FRAME_CURSOR_COLOR (frame) colorUsingColorSpace: space] getComponents: rgba];
+  CGColorRef color = CGColorCreateSRGB (rgba[0], rgba[1], rgba[2], 1);
+
+  if (!head)
+    {
+      NSNull *none = [NSNull null];
+
+      head = [[CAShapeLayer alloc] init];
+      trail = [[CAShapeLayer alloc] init];
+      for (CALayer *layer in @[trail, head])
+	{
+	  [layer setActions: @{@"path": none, @"fillColor": none,
+			       @"opacity": none}];
+	  [parent addSublayer: layer];
+	}
+    }
+
+  /* The shapes at a number of times during the movement, which are shown
+     one after the other, instead of animated.  */
+  NSMutableArray *heads = [NSMutableArray arrayWithCapacity: STEPS];
+  NSMutableArray *trails = [NSMutableArray arrayWithCapacity: STEPS];
+  for (int i = 0; i < STEPS; i++)
+    {
+      double head_corners[4][2], trail_corners[4][2];
+      CGPathRef path;
+
+      gui_cursor_glide_shape (frame, (double) i / (STEPS - 1), trail_corners,
+			      head_corners);
+      path = ns_glide_path (parent, head_corners);
+      [heads addObject: (id) path];
+      CGPathRelease (path);
+      path = ns_glide_path (parent, trail_corners);
+      [trails addObject: (id) path];
+      CGPathRelease (path);
+    }
+
+  /* The last shapes stay after the movement, until the cursor is drawn.  */
+  NSArray *layers[] = { @[head, heads], @[trail, trails] };
+  for (int i = 0; i < 2; i++)
+    {
+      CAShapeLayer *layer = layers[i][0];
+      NSArray *paths = layers[i][1];
+      CAKeyframeAnimation *animation
+	= [CAKeyframeAnimation animationWithKeyPath: @"path"];
+
+      [layer setFrame: [parent bounds]];
+      [layer setFillColor: color];
+      [layer setPath: (CGPathRef) [paths lastObject]];
+      [layer setOpacity: 1];
+      [animation setValues: paths];
+      [animation setCalculationMode: kCAAnimationDiscrete];
+      [animation setDuration: frame->cursor_glide.duration];
+      [layer addAnimation: animation forKey: @"glide"];
+    }
+
+  CGColorRelease (color);
+  [NSObject cancelPreviousPerformRequestsWithTarget: self];
+  [self performSelector: @selector (land) withObject: nil
+	     afterDelay: frame->cursor_glide.duration
+		inModes: @[NSRunLoopCommonModes]];
+}
+
+
+/* Stop showing the cursor.  */
+- (void) hide
+{
+  [NSObject cancelPreviousPerformRequestsWithTarget: self];
+  for (CALayer *layer in @[head, trail])
+    {
+      [layer removeAllAnimations];
+      [layer setOpacity: 0];
+    }
+}
+
+
+/* The movement is over.  */
+- (void) land
+{
+  if (view && FRAME_LIVE_P (frame) && frame->output_data.ns)
+    gui_cursor_glide_land (frame);
+}
+
+@end /* EmacsCursorGlide */
+
+
 
 #endif /* NS_IMPL_COCOA */
 
