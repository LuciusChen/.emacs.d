+(defun image-tests--check-alpha-mask (type data)
+  "Check the alpha mask of an image with TYPE and DATA."
+  (let ((spec (create-image data type t)))
+    (should (image-mask-p spec))
+    (should-not
+     (image-mask-p (append spec '(:background "black"))))))
+
