+- (EmacsImage *)copyWithBackgroundColor: (NSColor *)color
+{
+  NSRect bounds = NSMakeRect (0, 0, [self size].width, [self size].height);
+  EmacsImage *image = [[EmacsImage alloc] initWithSize:[self size]];
+
+  [image lockFocus];
+  [color set];
