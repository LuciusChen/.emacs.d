+(defun image-tests--check-ns-alpha-image (type data)
+  "Check that NS can load an alpha image with TYPE and DATA.
+NS stores alpha in its image bitmap rather than in `image-mask-p'."
+  (let ((spec (create-image data type t)))
+    (should (equal (image-size spec t) '(2 . 1)))
+    (should-not (image-mask-p spec))
+    (should-not
+     (image-mask-p (append spec '(:background "black"))))))
+
+(ert-deftest image-tests-load-alpha/ns-png ()
+  (image-skip-unless 'png (eq window-system 'ns))
+  (image-tests--check-ns-alpha-image 'png image-tests--alpha-png))
+
+(ert-deftest image-tests-load-alpha/ns-svg ()
+  (image-skip-unless 'svg (eq window-system 'ns))
+  (image-tests--check-ns-alpha-image 'svg image-tests--alpha-svg))
+
+(ert-deftest image-tests-load-alpha/ns-webp ()
+  (image-skip-unless 'webp (eq window-system 'ns))
+  (image-tests--check-ns-alpha-image 'webp image-tests--alpha-webp))
+
 (ert-deftest image-tests-image-mask-p/xbm ()
   (image-skip-unless 'xbm)
   (should-not (image-mask-p (cdr (assq 'xbm image-tests--images)))))
